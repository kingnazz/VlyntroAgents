NODE_ENV=development
# Optional frontend-only release tag; defaults to IMAGE_TAG.
WEB_IMAGE_TAG=
APP_BASE_URL=http://localhost:3000
APP_DOMAIN=agents.vlyntro.com
API_INTERNAL_URL=http://127.0.0.1:4000
API_PORT=4000
DATABASE_URL=postgres://hq:local-development-only@127.0.0.1:55432/hq
POSTGRES_DB=hq
POSTGRES_USER=hq
POSTGRES_PASSWORD=local-development-only
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
XAI_API_KEY=
OPENAI_MODEL=gpt-4.1
ANTHROPIC_MODEL=claude-sonnet-4-20250514
XAI_MODEL=grok-3-mini
CODEX_ENABLED=false
CODEX_WORKSPACE_ROOT=/workspaces/vlyntro
CODEX_COMMAND=/usr/local/bin/codex
CODEX_ARGS_JSON=["exec","--json","-"]
CODEX_TIMEOUT_MS=90000
CODEX_HOME_DIR=/tmp/codex-home
AGENT_MAX_HANDOFF_DEPTH=5
ARTIFACT_ROOT=./data/artifacts
# Admin inputs are used only by admin:create. Keep them out of runtime env files.
# ADMIN_EMAIL=
# ADMIN_DISPLAY_NAME=Nazar
# ADMIN_PASSWORD=
# E2E_EMAIL=
# E2E_PASSWORD=
# E2E_BASE_URL=http://localhost:3000
